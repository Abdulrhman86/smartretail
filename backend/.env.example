# Supabase Project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Key (backend only, bypasses RLS - keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Supabase Anon / Public Key (safe to expose client-side, respects RLS)
# Required for request-scoped user authentication calls (sign_up / sign_in_with_password / refresh)
SUPABASE_ANON_KEY=your_anon_public_key

# Gemini API key for the AI assistant (free tier: aistudio.google.com/apikey).
# Without it the assistant endpoints return 503; the rest of the API is unaffected.
GEMINI_API_KEY=your_gemini_api_key

# Optional: Gemini model (default gemini-3.5-flash-lite, chosen for free-tier rate limits)
# GEMINI_MODEL=gemini-3.6-flash

# Only needed to run scripts/fetch_product_images.py (free key: pexels.com/api).
# Not used at runtime.
# PEXELS_API_KEY=your_pexels_api_key

# Optional: comma-separated list of allowed frontend origins for CORS.
# Defaults to "*" (fine locally). In production set it to your Vercel URL, e.g.
# ALLOWED_ORIGINS=https://smartretail.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# Optional: seconds before a Supabase request times out (default 15)
# SUPABASE_TIMEOUT_SECONDS=15

# Optional: Python log level (default INFO)
# LOG_LEVEL=INFO
